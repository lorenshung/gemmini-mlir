diff --git a/examples/gemmini/timing/staged.hpp b/examples/gemmini/timing/staged.hpp
index 63c5cc0..a04a82e 100644
--- a/examples/gemmini/timing/staged.hpp
+++ b/examples/gemmini/timing/staged.hpp
@@ -12,6 +12,7 @@ struct StagedConfig {
   std::array<std::size_t, 2> dma_commands;
   std::array<ResourceId, 3> issue_resources, controller_resources;
   std::optional<Cycle> issue_latency, issue_occupancy;
