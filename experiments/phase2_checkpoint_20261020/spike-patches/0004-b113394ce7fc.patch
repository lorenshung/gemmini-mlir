   std::map<std::string, std::uint64_t> previous_classes_;
@@ -186,7 +227,8 @@ extern "C" spike_timing::TargetProvider *spike_timing_create_provider_v1(spike_t
     const auto mask = integer(*services, "custom_opcode_mask");
